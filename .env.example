# ─── Spotify Web API ───
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8001/api/public/auth/spotify/callback
FRONTEND_URL=http://127.0.0.1:5173

# ─── Google Gemini Pro ───
GEMINI_API_KEY=your_gemini_api_key

# ─── Gemini Rate Limits (Free Tier defaults) ───
SCANNER_MODE=free_tier
GEMINI_MODEL_RPM=5
GEMINI_MODEL_RPD=20
GEMINI_SEARCH_RPD=1500


# ─── Auth (Admin User & JWT) ───
# Generate a password hash with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$...
# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=generate_a_random_secret_here

# ─── Database ───
DATABASE_URL=sqlite:///./spotiscandals.db

# ─── CORS ───
CORS_ORIGINS=http://localhost:5173

# ─── Server ───
HOST=0.0.0.0
PORT=8000
